# ==============================================================================
# Ngrok + Nginx Multi-Service Switcher - Environment Variables Template
# Copy this file to '.env' and adjust the values according to your environment.
# ==============================================================================

# Port on the host machine where the Nginx switcher container will listen.
# This port must match the 'upstream.url' configured in ngrok.yml.
SWITCHER_PORT=3010

# Host machine resolution for Docker containers.
# On Docker Desktop (Windows/macOS) and modern Docker on Linux, 'host-gateway'
# maps 'host.docker.internal' directly to your host machine.
# If your services bind to a specific local LAN IP (e.g., 192.168.1.50), set it here.
LOCAL_HOST_IP=host-gateway

# Ngrok endpoint name as defined in your ngrok.yml
NGROK_ENDPOINT_NAME=my-switcher-endpoint

# (Optional) Public domain assigned by Ngrok
NGROK_PUBLIC_URL=https://your-domain.ngrok-free.app
